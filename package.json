{
  "name": "opal-ai-tutor",
  "version": "1.0.0",
  "description": "AI-powered desktop tutoring application with screen capture, OCR, and interactive learning modes",
  "main": "dist/main/main.js",
  "scripts": {
    "dev": "concurrently \"npm run dev:main\" \"npm run dev:renderer\"",
    "dev:main": "tsc -p tsconfig.main.json && electron .",
    "dev:renderer": "vite",
    "build": "npm run build:renderer && npm run build:main",
    "build:main": "tsc -p tsconfig.main.json",
    "build:renderer": "vite build",
    "preview": "vite preview",
    "start": "electron .",
    "package": "npm run build && electron-builder",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:ci": "npm run build && playwright test",
    "test:all": "npm test && npm run build && playwright test"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.32.0",
    "electron-store": "^8.2.0",
    "katex": "^0.16.9",
    "lucide-react": "^0.462.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "tesseract.js": "^5.0.4"
  },
  "devDependencies": {
    "@types/katex": "^0.16.7",
    "@types/node": "^20.10.0",
    "@types/react": "^18.2.0",
    "@playwright/test": "^1.51.0",
    "@types/react-dom": "^18.2.0",
    "@vitejs/plugin-react": "^4.2.0",
    "autoprefixer": "^10.4.16",
    "concurrently": "^8.2.2",
    "electron": "^40.0.0",
    "electron-builder": "^26.5.0",
    "postcss": "^8.4.32",
    "tailwindcss": "^3.3.6",
    "typescript": "^5.3.0",
    "vite": "^7.3.1",
    "vitest": "^3.0.5"
  },
  "build": {
    "appId": "com.opal.aitutor",
    "productName": "Opal AI Tutor",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "node_modules/**/*"
    ],
    "win": {
      "target": "nsis"
    },
    "mac": {
      "target": "dmg"
    },
    "linux": {
      "target": "AppImage"
    }
  }
}
